<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: white + circular logo (192dp, same size/position as the web splash logo).
     Only for the launch theme. Do NOT use it for AppTheme.NoActionBar: Capacitor reads that theme's windowBackground as a colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_background" />
    </item>
    <item android:width="192dp" android:height="192dp" android:gravity="center">
        <bitmap android:src="@drawable/splash_logo" android:gravity="fill" />
    </item>
</layer-list>
